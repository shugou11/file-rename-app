  // ===== ZIPダウンロード =====
  zipBtn.addEventListener("click", function(){
    if(files.length === 0) return;
    if(!confirmUnset()) return;

    zipBtn.disabled = true;
    setStatus("ZIPを作成中…", false);

    try{
      var zip = new JSZip();
      var numbers = computeNumbers();
      files.forEach(function(item, i){
        var p = buildPath(item, numbers[i], getExt(item.file.name));
        zip.file(p.full, item.file);
      });
      zip.generateAsync({type:"blob"}).then(function(blob){
        var a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "書類整理_" + formatDate() + ".zip";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function(){ URL.revokeObjectURL(a.href); }, 2000);
        setStatus("ダウンロードを開始しました（" + files.length + " 件）", false);
        zipBtn.disabled = false;
      }).catch(function(err){
        console.error(err);
        setStatus("ZIP作成に失敗しました。もう一度お試しください。", true);
        zipBtn.disabled = false;
      });
    }catch(err){
      console.error(err);
      setStatus("ZIP作成に失敗しました。もう一度お試しください。", true);
      zipBtn.disabled = false;
    }
  });

  clearBtn.addEventListener("click", function(){
    files = [];
    setStatus("リストを空にしました", false);
    renderAll();
  });

  // ===== 層の名前・項目の保存と読み込み =====
  function saveLayers(){
    try{
      idbSet("layersConfig2", LAYERS.map(function(L){
        return {
          key: L.key,
          label: L.label,
          items: L.items.map(function(it){
            return { name: it.name, parents: it.parents ? it.parents.slice() : null };
          })
        };
      })).catch(function(){});
    }catch(e){}
  }

  // 「名前を変更」ボタン
  Array.prototype.forEach.call(document.querySelectorAll(".edit-label"), function(btn){
    btn.onclick = function(){
      var key = btn.getAttribute("data-layer");
      var L = getLayer(key);
      var v = prompt("この層の名前を入力してください", L.label);
      if(v === null) return;
      v = sanitize(v);
      if(!v) return;
      L.label = v;
      saveLayers();
      renderAll();
    };
  });

  // 保存済みの設定があれば読み込む（旧形式の設定は無視して新しい初期値を使用）
  (function(){
    try{
      idbGet("layersConfig2").then(function(cfg){
        if(cfg && cfg.length){
          cfg.forEach(function(saved){
            var L = getLayer(saved.key);
            if(L && saved.label){ L.label = saved.label; }
            if(L && saved.items){
              L.items = saved.items.map(function(it){
                return { name: it.name, parents: it.parents ? it.parents.slice() : null };
              });
            }
          });
          renderAll();
        }
      }).catch(function(){});
    }catch(e){}
  })();

  renderAll();
})();
</script>
</body>
</html>
