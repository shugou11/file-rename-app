  function makeLayerSelect(item, layerKey){
    var select = document.createElement("select");
    if(item.auto && item.auto[layerKey]){ select.className = "auto"; select.title = "ファイル名から自動判定"; }
    if(!item[layerKey]){ select.className = "unset"; }
    var optNone = document.createElement("option");
    optNone.value = ""; optNone.textContent = "（なし）";
    select.appendChild(optNone);

    var pk = prevKey(layerKey);
    var parentVal = pk ? item[pk] : "";
    var names = itemNames(visibleItems(layerKey, parentVal));
    // 現在の値がフィルタ外でも選択肢に残す（値を失わないように）
    if(item[layerKey] && names.indexOf(item[layerKey]) === -1){
      names.push(item[layerKey]);
    }
    names.forEach(function(t){
      var opt = document.createElement("option");
      opt.value = t; opt.textContent = t;
      if(item[layerKey] === t) opt.selected = true;
      select.appendChild(opt);
    });
    select.onchange = function(){
      item[layerKey] = select.value || null;
      if(item.auto){ item.auto[layerKey] = false; }
      validateChain(item);   // 上の層を変えたら合わない下の層をクリア
      renderAll();
    };
    return select;
