  async function saveToDir(dirHandle){
    saveBtn.disabled = true;
    lastBtn.disabled = true;
    zipBtn.disabled = true;
    var numbers = computeNumbers();
    var done = 0, failed = 0;

    for(var i = 0; i < files.length; i++){
      var item = files[i];
      try{
        var p = buildPath(item, numbers[i], getExt(item.file.name));
        var target = dirHandle;
        if(p.folder){
          var segs = p.folder.split("/");
          for(var s = 0; s < segs.length; s++){
            target = await target.getDirectoryHandle(segs[s], {create:true});
          }
        }
        var fh = await target.getFileHandle(p.name, {create:true});
        var writable = await fh.createWritable();
        await writable.write(item.file);
        await writable.close();
        done++;
        setStatus("保存中… " + done + " / " + files.length, false);
      }catch(err){
        console.error(err);
        failed++;
      }
    }

    if(failed === 0){
      setStatus("完了！ " + done + " 件を「" + dirHandle.name + "」に保存しました", false);
    }else{
      setStatus(done + " 件保存しました。" + failed + " 件は保存できませんでした。", true);
    }
    saveBtn.disabled = false;
    lastBtn.disabled = false;
    zipBtn.disabled = false;
  }

