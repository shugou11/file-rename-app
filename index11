  function addFiles(list){
    var added = 0;
    Array.prototype.forEach.call(list, function(f){
      var item = {file:f, l2:null, l3:null, l4:null, l5:null, auto:{l2:false,l3:false,l4:false,l5:false}};
      LAYERS.forEach(function(L){
        if(active[L.key]){
          item[L.key] = active[L.key];
        }else{
          var d = detectLayer(L.key, f.name);
          if(d){ item[L.key] = d; item.auto[L.key] = true; }
        }
      });
      files.push(item);
      validateChain(item);
      added++;
    });
    var sel = [active.l2, active.l3, active.l4, active.l5].filter(Boolean);
    var msg = added + " 件追加";
