<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>書類一括リネーム＆フォルダ分け</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>
  :root{
    --ink:#1f2a44;
    --ink-soft:#5a6580;
    --paper:#f7f8f6;
    --grid:#e3e7e0;
    --line:#c9d0c5;
    --accent:#b5342a;
    --accent-soft:#f6e7e5;
    --ok:#2e7d4f;
    --mono:"Consolas","Menlo","MS Gothic",monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:"Yu Gothic UI","Yu Gothic","Hiragino Kaku Gothic ProN",sans-serif;
    color:var(--ink);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      var(--paper);
    background-size:24px 24px,24px 24px,auto;
    min-height:100vh;
    padding:24px 16px 64px;
  }
  .sheet{max-width:940px;margin:0 auto}

  header{
    border:2px solid var(--ink);
    background:#fff;
    display:flex;
    align-items:stretch;
    margin-bottom:20px;
  }
  .tb-main{flex:1;padding:16px 20px;border-right:2px solid var(--ink)}
  .tb-main h1{
    font-family:"Yu Mincho","Hiragino Mincho ProN",serif;
    font-size:1.35rem;letter-spacing:.12em;
  }
  .tb-main p{font-size:.8rem;color:var(--ink-soft);margin-top:4px;letter-spacing:.05em}
  .tb-stamp{
    width:84px;display:flex;align-items:center;justify-content:center;
    color:var(--accent);
  }
  .tb-stamp span{
    border:2.5px solid var(--accent);border-radius:50%;
    width:56px;height:56px;display:flex;align-items:center;justify-content:center;
    font-family:"Yu Mincho",serif;font-size:.95rem;font-weight:700;
    transform:rotate(-8deg);letter-spacing:.05em;
  }

  .card{
    background:#fff;border:1px solid var(--line);
    padding:20px;margin-bottom:16px;
  }
  .card h2{
    font-size:.8rem;letter-spacing:.2em;color:var(--ink-soft);
    border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:16px;
    font-weight:600;
  }

  /* 分類レイヤー */
  .layer{margin-bottom:18px}
  .layer:last-child{margin-bottom:0}
  .layer-title{
    font-size:.82rem;font-weight:700;margin-bottom:8px;
    display:flex;align-items:center;gap:10px;
  }
  .layer-title .edit-label{
    border:1px solid var(--line);background:#fff;color:var(--ink-soft);
    font-size:.72rem;padding:3px 9px;cursor:pointer;font-family:inherit;
  }
  .layer-title .edit-label:hover{border-color:var(--ink);color:var(--ink)}
  .layer-title .tag{
    display:inline-block;background:var(--ink);color:#fff;
    font-size:.68rem;padding:2px 8px;letter-spacing:.1em;font-weight:600;
  }
  .chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .chip{
    display:inline-flex;align-items:center;gap:8px;
    border:1.5px solid var(--ink);background:#fff;
    padding:5px 8px 5px 12px;font-size:.87rem;font-weight:600;
    cursor:pointer;user-select:none;
  }
  .chip:hover{background:var(--paper)}
  .chip.active{background:var(--ink);color:#fff}
  .chip.active button{color:#c8cede}
  .chip button{
    border:none;background:none;color:var(--ink-soft);cursor:pointer;
    font-size:.95rem;line-height:1;padding:2px 3px;
  }
  .chip button:hover{color:var(--accent)}
  .chip-add{display:inline-flex;gap:0}
  .chip-add input{
    width:110px;padding:5px 8px;border:1.5px dashed var(--ink-soft);
    font-size:.83rem;font-family:inherit;border-radius:0;color:var(--ink);
    border-right:none;
  }
  .chip-add input:focus{outline:none;border-color:var(--ink);border-style:solid}
  .chip-add button{
    border:1.5px dashed var(--ink-soft);border-left:none;background:#fff;
    color:var(--ink-soft);padding:0 10px;cursor:pointer;font-size:.83rem;font-family:inherit;
  }
  .chip-add button:hover{color:var(--ink);border-color:var(--ink)}
  .active-hint{
    margin-top:14px;font-size:.85rem;color:var(--accent);font-weight:600;
  }

  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px}
  .field label{display:block;font-size:.78rem;color:var(--ink-soft);margin-bottom:5px;letter-spacing:.05em}
  .field input,.field select{
    width:100%;padding:9px 10px;border:1px solid var(--line);
    font-size:.95rem;font-family:inherit;background:#fff;color:var(--ink);border-radius:0;
  }
  .field input:focus,.field select:focus{outline:2px solid var(--ink);outline-offset:1px}

  .name-preview{
    margin-top:14px;padding:14px 16px;background:var(--paper);
    border:1px dashed var(--ink-soft);
    font-family:var(--mono);font-size:1rem;word-break:break-all;
  }
  .name-preview .lbl{
    display:block;font-family:"Yu Gothic UI",sans-serif;
    font-size:.72rem;color:var(--ink-soft);margin-bottom:6px;letter-spacing:.15em;
  }
  .name-preview .folder{color:var(--accent);font-weight:700}

  .drop{
    border:2px dashed var(--ink-soft);background:#fff;
    padding:34px 20px;text-align:center;cursor:pointer;
    transition:background .15s,border-color .15s;
  }
  .drop:hover,.drop:focus-visible{border-color:var(--ink);background:var(--paper)}
  .drop.over{border-color:var(--accent);background:var(--accent-soft)}
  .drop p{font-size:.98rem}
  .drop small{display:block;margin-top:6px;color:var(--ink-soft);font-size:.78rem}
  .drop:focus-visible{outline:2px solid var(--ink);outline-offset:2px}

  .src-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}

  .picker{margin-top:14px;border:1.5px solid var(--ink);background:#fff}
  .picker-head{
    display:flex;align-items:center;gap:16px;
    padding:10px 14px;border-bottom:1px solid var(--line);
    background:var(--paper);font-size:.85rem;
  }
  .picker-head label{display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:600}
  .picker-head input{width:16px;height:16px;accent-color:var(--accent)}
  .picker-head span{color:var(--ink-soft);font-size:.8rem}
  .picker-list{max-height:300px;overflow-y:auto}
  .pick-row{
    display:flex;align-items:center;gap:12px;
    padding:8px 14px;border-bottom:1px solid var(--grid);
    font-size:.86rem;cursor:pointer;
  }
  .pick-row:hover{background:var(--paper)}
  .pick-row input{width:16px;height:16px;accent-color:var(--accent);flex-shrink:0}
  .pick-row .pname{flex:1;word-break:break-all}
  .pick-row .pdate{color:var(--ink-soft);font-size:.76rem;font-family:var(--mono);white-space:nowrap}
  .picker-foot{
    display:flex;align-items:center;gap:12px;flex-wrap:wrap;
    padding:12px 14px;border-top:1px solid var(--line);
  }
  .picker-foot .btn-primary{padding:10px 20px;font-size:.9rem}
  .picker-foot .btn-sub{padding:9px 14px}

  table{width:100%;border-collapse:collapse;font-size:.83rem}
  th{
    text-align:left;font-size:.7rem;letter-spacing:.1em;color:var(--ink-soft);
    border-bottom:1px solid var(--ink);padding:6px 6px;font-weight:600;
  }
  td{border-bottom:1px solid var(--grid);padding:7px 6px;vertical-align:middle}
  td.no{width:30px;color:var(--ink-soft);font-family:var(--mono)}
  td.old{color:var(--ink-soft);word-break:break-all;font-size:.78rem}
  td.sel select{
    padding:5px 6px;border:1px solid var(--line);font-family:inherit;
    font-size:.8rem;background:#fff;color:var(--ink);max-width:110px;border-radius:0;
  }
  td.sel select.auto{border-color:var(--ok)}
  td.sel select.unset{border-color:var(--accent);background:var(--accent-soft)}
  td.new{font-family:var(--mono);word-break:break-all;font-weight:600;font-size:.78rem}
  td.new .folder{color:var(--accent)}
  td.ctrl{width:100px;white-space:nowrap;text-align:right}
  .mini{
    border:1px solid var(--line);background:#fff;color:var(--ink);
    width:27px;height:27px;cursor:pointer;font-size:.8rem;margin-left:3px;
  }
  .mini:hover{border-color:var(--ink)}
  .mini.del:hover{border-color:var(--accent);color:var(--accent)}
  .mini:disabled{opacity:.3;cursor:default}
  .empty{color:var(--ink-soft);font-size:.85rem;text-align:center;padding:22px 0}

  .actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:18px}
  .btn-primary{
    background:var(--accent);color:#fff;border:none;
    padding:13px 26px;font-size:1rem;font-family:inherit;
    letter-spacing:.1em;cursor:pointer;font-weight:600;
  }
  .btn-primary:hover{background:#9c2b22}
  .btn-primary:disabled{background:#c9c9c9;cursor:default}
  .btn-sub{
    background:#fff;border:1px solid var(--ink);color:var(--ink);
    padding:12px 18px;font-size:.88rem;font-family:inherit;cursor:pointer;
  }
  .btn-sub:hover{background:var(--paper)}
  .btn-sub:disabled{opacity:.4;cursor:default}
  .status{font-size:.85rem;color:var(--ok);font-weight:600}
  .status.err{color:var(--accent)}

  @media(max-width:640px){
    td.old,th.old{display:none}
    .tb-stamp{display:none}
    .tb-main{border-right:none}
    td.sel select{max-width:88px}
  }
</style>
</head>
<body>
<div class="sheet">

  <header>
    <div class="tb-main">
      <h1>書類一括リネーム＆フォルダ分け</h1>
      <p>日付 → 分類 → 業者・部位 → 種類 の4階層に自動整理｜処理はこの画面内で完結</p>
    </div>
    <div class="tb-stamp"><span>整理</span></div>
  </header>

  <section class="card">
    <h2>01｜分類の選択（クリックで選択 → その状態で追加したファイルに適用）</h2>

    <div class="layer">
      <div class="layer-title"><span class="tag">第2層</span><span id="nameL2">分類</span><button class="edit-label" data-layer="l2">名前を変更</button></div>
      <div class="chips" id="chipsL2"></div>
    </div>

    <div class="layer">
      <div class="layer-title"><span class="tag">第3層</span><span id="nameL3">業者・部位</span><button class="edit-label" data-layer="l3">名前を変更</button></div>
      <div class="chips" id="chipsL3"></div>
    </div>

    <div class="layer">
      <div class="layer-title"><span class="tag">第4層</span><span id="nameL4">種類</span><button class="edit-label" data-layer="l4">名前を変更</button></div>
      <div class="chips" id="chipsL4"></div>
    </div>

    <div class="layer">
      <div class="layer-title"><span class="tag">第5層</span><span id="nameL5">詳細</span><button class="edit-label" data-layer="l5">名前を変更</button></div>
      <div class="chips" id="chipsL5"></div>
    </div>

    <p class="active-hint" id="activeHint" style="display:none"></p>
  </section>

  <section class="card">
    <h2>02｜日付・ファイル名のルール</h2>
    <div class="form-grid">
      <div class="field">
        <label for="date">日付（第1層のフォルダ名になります）</label>
        <input type="date" id="date">
      </div>
      <div class="field">
        <label for="dateFmt">日付の形式</label>
        <select id="dateFmt">
          <option value="YYYYMMDD">20260709</option>
          <option value="YYYY-MM-DD">2026-07-09</option>
          <option value="YYMMDD">260709</option>
        </select>
      </div>
      <div class="field">
        <label for="order">ファイル名の並び順</label>
        <select id="order">
          <option value="t-d-n">業者・部位 → 日付 → 連番</option>
          <option value="d-t-n">日付 → 業者・部位 → 連番</option>
          <option value="t-n-d">業者・部位 → 連番 → 日付</option>
        </select>
      </div>
      <div class="field">
        <label for="start">連番の開始</label>
        <input type="number" id="start" value="1" min="0">
      </div>
      <div class="field">
        <label for="digits">連番の桁数</label>
        <select id="digits">
          <option value="2">2桁（01）</option>
          <option value="3" selected>3桁（001）</option>
          <option value="4">4桁（0001）</option>
        </select>
      </div>
      <div class="field">
        <label for="sep">区切り文字</label>
        <select id="sep">
          <option value="_">アンダーバー（_）</option>
          <option value="-">ハイフン（-）</option>
        </select>
      </div>
    </div>
    <p style="font-size:.78rem;color:var(--ink-soft);margin-top:12px">※ 連番は保存先フォルダごとに開始番号からリセットされます。未選択の層はフォルダを作らず飛ばします。</p>
    <div class="name-preview">
      <span class="lbl">仕上がりイメージ</span>
      <span id="previewText"></span>
    </div>
  </section>

  <section class="card">
    <h2>03｜ファイル</h2>
    <div class="drop" id="drop" role="button" tabindex="0" aria-label="ファイルを選択">
      <p>ここにファイルをドラッグ＆ドロップ</p>
      <small id="dropHint">PDF・写真・Excel・Wordなど何でもOK（複数可）。ファイル名に「ヨシタニ」「見積」などが含まれていれば自動判定します</small>
      <input type="file" id="fileInput" multiple hidden>
    </div>

    <div class="src-row">
      <button class="btn-sub" id="lastSrcBtn" style="display:none"></button>
      <button class="btn-sub" id="srcBtn">フォルダから読み込む（例：ダウンロード）</button>
    </div>

    <div class="picker" id="picker" style="display:none">
      <div class="picker-head">
        <label><input type="checkbox" id="pickAll"> すべて選択</label>
        <span id="pickerTitle"></span>
      </div>
      <div class="picker-list" id="pickerList"></div>
      <div class="picker-foot">
        <button class="btn-primary" id="pickAdd">選択したファイルを追加</button>
        <button class="btn-sub" id="pickCancel">閉じる</button>
        <span class="status" id="pickCount"></span>
      </div>
    </div>

    <div style="margin-top:16px">
      <table id="fileTable" style="display:none">
        <thead>
          <tr>
            <th>No.</th>
            <th class="old">元のファイル名</th>
            <th id="thL2">分類</th>
            <th id="thL3">業者・部位</th>
            <th id="thL4">種類</th>
            <th id="thL5">詳細</th>
            <th>新しい保存先・ファイル名</th>
            <th style="text-align:right"></th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
      <p class="empty" id="emptyMsg">まだファイルがありません。上のエリアに追加してください。</p>
    </div>

    <div class="actions">
      <button class="btn-primary" id="lastBtn" style="display:none"></button>
      <button class="btn-primary" id="saveBtn" disabled>フォルダを選んで直接保存</button>
      <button class="btn-sub" id="zipBtn" disabled>ZIPでダウンロード</button>
      <button class="btn-sub" id="clearBtn" disabled>リストを空にする</button>
      <span class="status" id="status"></span>
    </div>
    <p style="font-size:.78rem;color:var(--ink-soft);margin-top:10px" id="saveHint">
      「直接保存」は保存先フォルダを選ぶと、その中に日付・分類のフォルダを作ってリネーム済みファイルを書き込みます（Chrome / Edge対応）。一度保存すると次回から「前回のフォルダに保存」でワンクリック保存できます。Googleドライブ（パソコン版）のフォルダを選べば、自動でクラウドにも同期されます。
    </p>
  </section>

</div>

<script>
(function(){
  "use strict";

  // ===== 分類の定義（親子関係つき。項目も層の名前も自由に変更でき、ブラウザに記憶されます） =====
  // parents: null = どの選択でも表示される「共通」項目
  // parents: ["メーカー"] = 上の層で「メーカー」を選んだときだけ表示
  var LAYERS = [
    { key:"l2", label:"分類", items:[
      {name:"メーカー", parents:null},
      {name:"仕様書",   parents:null},
      {name:"見積",     parents:null}
    ]},
    { key:"l3", label:"業者・部位", items:[
      {name:"建具",     parents:["仕様書","見積"]},
      {name:"水廻り",   parents:["仕様書","見積"]},
      {name:"その他",   parents:["仕様書","見積"]},
      {name:"ヨシタニ", parents:["メーカー"]},
      {name:"丸栄木材", parents:["メーカー"]},
      {name:"川根塗装", parents:["メーカー"]},
      {name:"大松",     parents:["メーカー"]},
      {name:"高柴",     parents:["メーカー"]}
    ]},
    { key:"l4", label:"種類", items:[
      {name:"見積", parents:null},
      {name:"図面", parents:null},
      {name:"PB",   parents:null}
    ]},
    { key:"l5", label:"詳細", items:[] }
  ];
  var LAYER_ORDER = ["l2","l3","l4","l5"];
  function prevKey(key){
    var i = LAYER_ORDER.indexOf(key);
    return i > 0 ? LAYER_ORDER[i-1] : null;
  }
  function getLayer(key){
    return LAYERS.filter(function(L){ return L.key === key; })[0];
  }
  // その層で表示する項目（親の選択値に応じて絞り込み）
  function visibleItems(key, parentVal){
    return getLayer(key).items.filter(function(it){
      if(!it.parents) return true;                      // 共通項目は常に表示
      return parentVal && it.parents.indexOf(parentVal) !== -1;
    });
  }
  function itemNames(list){
    return list.map(function(it){ return it.name; });
  }
  // 選択チェーンの整合性を保つ（上の層を変えたら、合わない下の層はクリア）
  function validateChain(obj){
    for(var i=1; i<LAYER_ORDER.length; i++){
      var key = LAYER_ORDER[i];
      var pv = obj[LAYER_ORDER[i-1]];
      if(obj[key]){
        var ok = itemNames(visibleItems(key, pv)).indexOf(obj[key]) !== -1;
        if(!ok){ obj[key] = null; }
      }
    }
  }
  var active = { l2:null, l3:null, l4:null, l5:null };   // 選択中の値
  var files = [];  // {file:File, l2, l3, l4, l5, auto:{...}}

  var $ = function(id){ return document.getElementById(id); };
  var chipEls = { l2:$("chipsL2"), l3:$("chipsL3"), l4:$("chipsL4"), l5:$("chipsL5") };
  var nameEls = { l2:$("nameL2"), l3:$("nameL3"), l4:$("nameL4"), l5:$("nameL5") };
  var thEls = { l2:$("thL2"), l3:$("thL3"), l4:$("thL4"), l5:$("thL5") };
  var activeHint = $("activeHint"), dropHint = $("dropHint"),
      dateEl = $("date"), dateFmt = $("dateFmt"),
      order = $("order"), start = $("start"), digits = $("digits"), sep = $("sep"),
      drop = $("drop"), fileInput = $("fileInput"), tbody = $("tbody"),
      table = $("fileTable"), emptyMsg = $("emptyMsg"),
      zipBtn = $("zipBtn"), saveBtn = $("saveBtn"), lastBtn = $("lastBtn"), clearBtn = $("clearBtn"), statusEl = $("status"),
      srcBtn = $("srcBtn"), lastSrcBtn = $("lastSrcBtn"),
      picker = $("picker"), pickerList = $("pickerList"), pickerTitle = $("pickerTitle"),
      pickAll = $("pickAll"), pickAdd = $("pickAdd"), pickCancel = $("pickCancel"), pickCount = $("pickCount"),
      previewText = $("previewText");

  (function(){
    var d = new Date();
    var m = ("0"+(d.getMonth()+1)).slice(-2);
    var day = ("0"+d.getDate()).slice(-2);
    dateEl.value = d.getFullYear()+"-"+m+"-"+day;
  })();

  function sanitize(s){
    return s.replace(/[\\\/:*?"<>|]/g, "").trim();
  }

  function formatDate(){
    var v = dateEl.value;
    if(!v) return "";
    var p = v.split("-");
    var fmt = dateFmt.value;
    if(fmt === "YYYYMMDD") return p[0]+p[1]+p[2];
    if(fmt === "YYMMDD") return p[0].slice(2)+p[1]+p[2];
    return v;
  }

  function pad(n){
    var s = String(n);
    var dg = parseInt(digits.value,10);
    while(s.length < dg){ s = "0"+s; }
    return s;
  }

  function getExt(fileName){
    var m = fileName.match(/\.[A-Za-z0-9]+$/);
    return m ? m[0].toLowerCase() : "";
  }

  // フォルダのパス（日付/分類/業者・部位/種類/詳細）。未選択の層は飛ばす
  function folderSegs(item){
    var segs = [];
    var d = formatDate();
    if(d) segs.push(d);
    if(item.l2) segs.push(sanitize(item.l2));
    if(item.l3) segs.push(sanitize(item.l3));
    if(item.l4) segs.push(sanitize(item.l4));
    if(item.l5) segs.push(sanitize(item.l5));
    return segs;
  }

  // ファイル名（業者・部位を名前に使用）
  function buildFileName(item, num, ext){
    var s = sep.value;
    var t = sanitize(item.l3 || item.l2 || "");
    var d = formatDate();
    var numStr = pad(num);
    var parts;
    switch(order.value){
      case "d-t-n": parts = [d, t, numStr]; break;
      case "t-n-d": parts = [t, numStr, d]; break;
      default:      parts = [t, d, numStr];
    }
    parts = parts.filter(function(x){ return x !== ""; });
    return parts.join(s) + (ext || "");
  }

  function buildPath(item, num, ext){
    var name = buildFileName(item, num, ext);
    var segs = folderSegs(item);
    if(segs.length){
      var folder = segs.join("/");
      return {folder: folder, name: name, full: folder + "/" + name};
    }
    return {folder: null, name: name, full: name};
  }

  // フォルダごとに連番をリセット
  function computeNumbers(){
    var base = parseInt(start.value,10)||0;
    var counters = {};
    return files.map(function(item){
      var key = folderSegs(item).join("/") || "__all__";
      if(counters[key] === undefined){ counters[key] = base; }
      var n = counters[key];
      counters[key]++;
      return n;
    });
  }

  // ファイル名から各層を自動判定（長い項目名を優先）
  function detectLayer(layerKey, fileName){
    var names = itemNames(getLayer(layerKey).items);
    var sorted = names.slice().sort(function(a,b){ return b.length - a.length; });
    for(var i=0;i<sorted.length;i++){
      if(fileName.indexOf(sorted[i]) !== -1) return sorted[i];
    }
    return null;
  }

  function escapeHtml(s){
    return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  // ===== 分類チップの描画 =====
  function renderChips(){
    LAYERS.forEach(function(L){
      nameEls[L.key].textContent = L.label;
