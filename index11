  function fmtDate(ms){
    var d = new Date(ms);
    var m = ("0"+(d.getMonth()+1)).slice(-2);
    var day = ("0"+d.getDate()).slice(-2);
    var h = ("0"+d.getHours()).slice(-2);
    var mi = ("0"+d.getMinutes()).slice(-2);
    return d.getFullYear()+"/"+m+"/"+day+" "+h+":"+mi;
  }

