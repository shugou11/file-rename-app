      var wrap = chipEls[L.key];
      wrap.innerHTML = "";

      var pk = prevKey(L.key);
      var parentVal = pk ? active[pk] : "";
      var visible = visibleItems(L.key, parentVal);

      // 上の層が未選択で隠れている項目がある場合の案内
      if(visible.length === 0 && L.items.length > 0 && pk){
        var note = document.createElement("span");
        note.style.cssText = "font-size:.8rem;color:var(--ink-soft);";
        note.textContent = "↑ " + getLayer(pk).label + "を選ぶと項目が表示されます";
        wrap.appendChild(note);
      }

      visible.forEach(function(it){
        var t = it.name;
        var chip = document.createElement("span");
        chip.className = "chip" + (active[L.key] === t ? " active" : "");
        chip.title = it.parents ? ("「" + it.parents.join("・") + "」配下の項目" ) : "共通項目（常に表示）";
        var label = document.createElement("span");
        label.textContent = t;
        var del = document.createElement("button");
        del.textContent = "×";
        del.title = t + " を削除";
        del.onclick = function(e){
          e.stopPropagation();
          if(!confirm("「" + t + "」を一覧から削除しますか？")) return;
          var idx = L.items.indexOf(it);
          if(idx !== -1){ L.items.splice(idx,1); }
          if(active[L.key] === t){ active[L.key] = null; }
          files.forEach(function(f){
            if(f[L.key] === t){ f[L.key] = null; }
          });
          validateChain(active);
          files.forEach(validateChain);
          saveLayers();
          renderAll();
        };
        chip.onclick = function(){
          active[L.key] = (active[L.key] === t) ? null : t;
          validateChain(active);
          renderAll();
        };
        chip.appendChild(label); chip.appendChild(del);
        wrap.appendChild(chip);
      });

      // 追加用の入力（上の層で選択中の項目の配下に追加される）
      var add = document.createElement("span");
      add.className = "chip-add";
      var input = document.createElement("input");
      input.type = "text";
      if(pk && active[pk]){
        input.placeholder = "＋「" + active[pk] + "」に追加";
        input.title = "「" + active[pk] + "」を選んだときだけ表示される項目として追加します";
      }else{
        input.placeholder = "＋追加（共通）";
        input.title = "どの選択でも表示される共通項目として追加します";
      }
      var btn = document.createElement("button");
      btn.textContent = "追加";
      function doAdd(){
        var v = sanitize(input.value);
        if(!v) return;
        var parentVal2 = pk ? active[pk] : null;
        // 同じ親のもとに同名があれば拒否
        var dup = L.items.some(function(it){
          if(it.name !== v) return false;
          if(!it.parents && !parentVal2) return true;
          if(it.parents && parentVal2 && it.parents.indexOf(parentVal2) !== -1) return true;
          return false;
        });
        if(dup){
          setStatus("「" + v + "」はすでにあります", true);
          return;
        }
        // 同名の共通/別親項目があれば親を追記、なければ新規
        var existing = L.items.filter(function(it){ return it.name === v && it.parents; })[0];
        if(existing && parentVal2){
          existing.parents.push(parentVal2);
        }else{
          L.items.push({ name:v, parents: parentVal2 ? [parentVal2] : null });
        }
        active[L.key] = v;
        saveLayers();
        renderAll();
      }
      btn.onclick = doAdd;
      input.onkeydown = function(e){
        if(e.key === "Enter"){ e.preventDefault(); doAdd(); }
      };
      add.appendChild(input); add.appendChild(btn);
      wrap.appendChild(add);
    });

    // 選択状態のヒント
    var sel = [active.l2, active.l3, active.l4, active.l5].filter(Boolean);
    if(sel.length){
      activeHint.style.display = "block";
      activeHint.textContent = "★ 選択中：追加するファイルは「" + formatDate() + " / " + sel.join(" / ") + "」に入ります";
      dropHint.textContent = "追加したファイルは「" + sel.join(" / ") + "」に振り分けられます";
    }else{
      activeHint.style.display = "none";
      dropHint.textContent = "PDF・写真・Excel・Wordなど何でもOK（複数可）。ファイル名に「ヨシタニ」「見積」などが含まれていれば自動判定します";
    }
  }

